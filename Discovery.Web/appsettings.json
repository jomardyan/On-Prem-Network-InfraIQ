{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=networkdiscovery.db"
  },
  "AdvancedNetworkDiscovery": {
    "DefaultTimeout": 5000,
    "MaxConcurrency": 200,
    "EnableMachineLearning": true,
    "EnableCloudIntegration": true,
    "DatabaseProvider": "SQLite"
  }
}
