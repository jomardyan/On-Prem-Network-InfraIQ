                    </p>
                    
                    <div class="row justify-content-center">
                        <div class="col-auto">
                            <div class="stat-card p-3 rounded">
                                <div class="stat-number">20+</div>
                                <div class="stat-label">Services Detected</div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="stat-card p-3 rounded">
                                <div class="stat-number">372</div>
                                <div class="stat-label">Test Cases</div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="stat-card p-3 rounded">
                                <div class="stat-number">99.7%</div>
                                <div class="stat-label">Success Rate</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="https://github.com/jomardyan/On-Prem-Network-InfraIQ" class="btn btn-outline-light" target="_blank">
