@{
    ViewData["Title"] = "Network Scanner";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">
                <i class="fas fa-search me-2 text-primary"></i>
                Network Scanner
            </h2>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#helpModal">
                    <i class="fas fa-question-circle me-1"></i>Help
                </button>
                <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#settingsModal">
                    <i class="fas fa-cog me-1"></i>Settings
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card glass-card h-100 animate-on-scroll">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-desktop me-2"></i>
                    Single IP Scan
                </h5>
                <small class="text-muted">Detailed port and service analysis for a specific target</small>
            </div>
            <div class="card-body">
                <form id="singleIpForm">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="ipAddress" placeholder="192.168.1.1" required>
                        <label for="ipAddress">
                            <i class="fas fa-globe me-1"></i>IP Address
                        </label>
                        <div class="form-text">
                            <i class="fas fa-info-circle me-1"></i>
                            Enter IPv4 (192.168.1.1) or IPv6 (2001:db8::1) address
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="singlePorts" placeholder="22,80,443,21,23,25,53" 
                               value="22,80,443,21,23,25,53,110,143,993,995,3389,5432,3306">
                        <label for="singlePorts">
                            <i class="fas fa-door-open me-1"></i>Ports (comma-separated)
                        </label>
                        <div class="form-text">
                            <i class="fas fa-lightbulb me-1"></i>
                            Leave empty for top 1000 ports
                            <button type="button" class="btn btn-link btn-sm p-0 ms-2" onclick="loadCommonPorts('single')">
                                Load Common Ports
                            </button>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="number" class="form-control" id="singleTimeout" value="5000" min="1000" max="30000">
                                <label for="singleTimeout">
                                    <i class="fas fa-clock me-1"></i>Timeout (ms)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <select class="form-control" id="singleScanType">
                                    <option value="connect">TCP Connect</option>
                                    <option value="syn">SYN Scan</option>
                                    <option value="udp">UDP Scan</option>
                                </select>
                                <label for="singleScanType">
                                    <i class="fas fa-cogs me-1"></i>Scan Type
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-play me-2"></i>Start IP Scan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-6 mb-4">
        <div class="card glass-card h-100 animate-on-scroll">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-network-wired me-2"></i>
                    Network Range Scan
                </h5>
                <small class="text-muted">Discover all active hosts in a network subnet</small>
            </div>
            <div class="card-body">
                <form id="networkRangeForm">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="networkRange" placeholder="192.168.1.0/24" required>
                        <label for="networkRange">
                            <i class="fas fa-sitemap me-1"></i>Network Range (CIDR)
                        </label>
                        <div class="form-text">
                            <i class="fas fa-info-circle me-1"></i>
                            Examples: 192.168.1.0/24, 10.0.0.0/16, 172.16.0.0/12
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="networkPorts" placeholder="22,80,443" value="22,80,443,21,23,25,53,135,139,445">
                        <label for="networkPorts">
                            <i class="fas fa-door-open me-1"></i>Ports (comma-separated)
                        </label>
                        <div class="form-text">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Fewer ports recommended for large networks
                            <button type="button" class="btn btn-link btn-sm p-0 ms-2" onclick="loadCommonPorts('network')">
                                Load Essential Ports
                            </button>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="number" class="form-control" id="networkTimeout" value="3000" min="1000" max="15000">
                                <label for="networkTimeout">
                                    <i class="fas fa-clock me-1"></i>Timeout (ms)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="number" class="form-control" id="maxConcurrency" value="100" min="1" max="500">
                                <label for="maxConcurrency">
                                    <i class="fas fa-tachometer-alt me-1"></i>Concurrency
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-play me-2"></i>Start Network Scan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Enhanced Progress Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card glass-card" id="progressCard" style="display: none;">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-line me-2"></i>Scan Progress
                    </h5>
                    <button class="btn btn-outline-danger btn-sm" id="stopScan">
                        <i class="fas fa-stop me-1"></i>Stop Scan
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="stat-card text-center p-3">
                            <div class="stat-number" id="progressHosts">0</div>
                            <div class="stat-label">Hosts Scanned</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card text-center p-3">
                            <div class="stat-number" id="progressPorts">0</div>
                            <div class="stat-label">Ports Checked</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card text-center p-3">
                            <div class="stat-number text-success" id="progressOpen">0</div>
                            <div class="stat-label">Open Ports</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card text-center p-3">
                            <div class="stat-number text-info" id="progressTime">0s</div>
                            <div class="stat-label">Elapsed Time</div>
                        </div>
                    </div>
                </div>
                
                <div class="progress-container">
                    <div class="progress-bar-gradient" id="progressBar" style="width: 0%"></div>
                </div>
                
                <div class="text-center mt-2">
                    <small class="text-muted" id="progressText">Preparing scan...</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card glass-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-list me-2"></i>
                    Scan Results
                    <span class="badge badge-gradient ms-2" id="resultCount">0</span>
                </h5>
                <div class="btn-group">
                    <button class="btn btn-outline-light btn-sm" id="clearResults" data-bs-toggle="tooltip" title="Clear all results">
                        <i class="fas fa-trash me-1"></i>Clear
                    </button>
                    <button class="btn btn-outline-success btn-sm" id="exportJson" data-bs-toggle="tooltip" title="Export as JSON">
                        <i class="fas fa-download me-1"></i>JSON
                    </button>
                    <button class="btn btn-outline-info btn-sm" id="exportCsv" data-bs-toggle="tooltip" title="Export as CSV">
                        <i class="fas fa-file-csv me-1"></i>CSV
                    </button>
                    <button class="btn btn-outline-warning btn-sm" id="shareResults" data-bs-toggle="tooltip" title="Share results">
                        <i class="fas fa-share me-1"></i>Share
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div id="scanStatus" class="alert alert-info" style="display: none;">
                    <div class="d-flex align-items-center">
                        <div class="spinner-border spinner-border-sm me-2" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span id="statusText">Initializing scan...</span>
                    </div>
                </div>
                
                <!-- Filter and Search Controls -->
                <div class="row mb-3" id="filterControls" style="display: none;">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" class="form-control" id="searchFilter" placeholder="Search IP, port, or service...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-control" id="serviceFilter">
                            <option value="">All Services</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-control" id="statusFilter">
                            <option value="">All Status</option>
                            <option value="open">Open Ports</option>
                            <option value="closed">Closed Ports</option>
                            <option value="filtered">Filtered Ports</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-light w-100" id="resetFilters">
                            <i class="fas fa-undo me-1"></i>Reset
                        </button>
                    </div>
                </div>
                
                <div id="resultsContainer">
                    <div class="text-center text-muted py-5" id="emptyState">
                        <i class="fas fa-search fa-3x mb-3 opacity-50"></i>
                        <p>No scan results yet. Start a scan to see results here.</p>
                        <button class="btn btn-primary" onclick="document.querySelector('#singleIpForm button').click()">
                            <i class="fas fa-play me-1"></i>Start Your First Scan
                        </button>
                    </div>
                </div>
                
                <div id="scanResults" style="display: none;">
                    <div class="table-responsive">
                        <table class="table table-dark table-striped table-hover">
                            <thead>
                                <tr>
                                    <th class="sortable" data-sort="ip">
                                        <i class="fas fa-globe me-1"></i>IP Address
                                        <i class="fas fa-sort ms-1"></i>
                                    </th>
                                    <th class="sortable" data-sort="port">
                                        <i class="fas fa-door-open me-1"></i>Port
                                        <i class="fas fa-sort ms-1"></i>
                                    </th>
                                    <th class="sortable" data-sort="service">
                                        <i class="fas fa-cogs me-1"></i>Service
                                        <i class="fas fa-sort ms-1"></i>
                                    </th>
                                    <th class="sortable" data-sort="status">
                                        <i class="fas fa-shield-alt me-1"></i>Status
                                        <i class="fas fa-sort ms-1"></i>
                                    </th>
                                    <th class="sortable" data-sort="time">
                                        <i class="fas fa-clock me-1"></i>Response Time
                                        <i class="fas fa-sort ms-1"></i>
                                    </th>
                                    <th>
                                        <i class="fas fa-tools me-1"></i>Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="resultsTableBody">
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Enhanced Statistics -->
                    <div class="mt-4">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="stat-card text-center p-3">
                                    <div class="stat-number text-success" id="totalHosts">0</div>
                                    <div class="stat-label">Total Hosts</div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="stat-card text-center p-3">
                                    <div class="stat-number text-info" id="openPorts">0</div>
                                    <div class="stat-label">Open Ports</div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="stat-card text-center p-3">
                                    <div class="stat-number text-warning" id="uniqueServices">0</div>
                                    <div class="stat-label">Services</div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="stat-card text-center p-3">
                                    <div class="stat-number text-primary" id="scanDuration">-</div>
                                    <div class="stat-label">Duration</div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="stat-card text-center p-3">
                                    <div class="stat-number text-secondary" id="avgResponse">-</div>
                                    <div class="stat-label">Avg Response</div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="stat-card text-center p-3">
                                    <div class="stat-number text-danger" id="vulnerabilities">0</div>
                                    <div class="stat-label">Vulnerabilities</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Help Modal -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="helpModalLabel">
                    <i class="fas fa-question-circle me-2"></i>Scanner Help & Tips
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6><i class="fas fa-lightbulb me-2"></i>Quick Tips</h6>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-check text-success me-1"></i> Use CIDR notation for networks (e.g., 192.168.1.0/24)</li>
                            <li><i class="fas fa-check text-success me-1"></i> Fewer ports = faster network scans</li>
                            <li><i class="fas fa-check text-success me-1"></i> Adjust timeout based on network speed</li>
                            <li><i class="fas fa-check text-success me-1"></i> Use keyboard shortcuts for efficiency</li>
                        </ul>
                        
                        <h6><i class="fas fa-keyboard me-2"></i>Keyboard Shortcuts</h6>
                        <ul class="list-unstyled">
                            <li><kbd>Ctrl</kbd> + <kbd>S</kbd> Start scan</li>
                            <li><kbd>Ctrl</kbd> + <kbd>R</kbd> Refresh results</li>
                            <li><kbd>Ctrl</kbd> + <kbd>E</kbd> Export results</li>
                            <li><kbd>Esc</kbd> Stop current scan</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6><i class="fas fa-chart-line me-2"></i>Performance Guidelines</h6>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-info text-info me-1"></i> <strong>Single IP:</strong> Use for detailed analysis</li>
                            <li><i class="fas fa-info text-info me-1"></i> <strong>Network Scan:</strong> Use for discovery</li>
                            <li><i class="fas fa-info text-info me-1"></i> <strong>Timeout:</strong> 1-5s for LAN, 5-15s for WAN</li>
                            <li><i class="fas fa-info text-info me-1"></i> <strong>Concurrency:</strong> 50-200 for most networks</li>
                        </ul>
                        
                        <h6><i class="fas fa-shield-alt me-2"></i>Best Practices</h6>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-exclamation-triangle text-warning me-1"></i> Always get permission before scanning</li>
                            <li><i class="fas fa-exclamation-triangle text-warning me-1"></i> Be respectful of network resources</li>
                            <li><i class="fas fa-exclamation-triangle text-warning me-1"></i> Review local laws and policies</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Settings Modal -->
<div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="settingsModalLabel">
                    <i class="fas fa-cog me-2"></i>Scanner Settings
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="settingsForm">
                    <div class="mb-3">
                        <label class="form-label">Default Timeout (ms)</label>
                        <input type="number" class="form-control" id="defaultTimeout" value="5000" min="1000" max="30000">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Default Concurrency</label>
                        <input type="number" class="form-control" id="defaultConcurrency" value="100" min="1" max="500">
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="autoExport" checked>
                            <label class="form-check-label" for="autoExport">
                                Auto-export results
                            </label>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="soundEffects">
                            <label class="form-check-label" for="soundEffects">
                                Sound effects
                            </label>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="darkMode" checked>
                            <label class="form-check-label" for="darkMode">
                                Dark mode
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveSettings()">Save Settings</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/scanner.js"></script>
    <script>
        function loadCommonPorts(type) {
            const commonPorts = {
                single: "22,23,25,53,80,110,135,139,143,443,993,995,3389,5432,3306,1433,5984,8080,8443,9200",
                network: "22,80,443,21,23,25,53,135,139,445"
            };
            
            const targetField = type === 'single' ? 'singlePorts' : 'networkPorts';
            document.getElementById(targetField).value = commonPorts[type];
            
            dashboard.showNotification(`Loaded ${type} scan common ports`, 'success', 2000);
        }
        
        function saveSettings() {
            const settings = {
                defaultTimeout: document.getElementById('defaultTimeout').value,
                defaultConcurrency: document.getElementById('defaultConcurrency').value,
                autoExport: document.getElementById('autoExport').checked,
                soundEffects: document.getElementById('soundEffects').checked,
                darkMode: document.getElementById('darkMode').checked
            };
            
            localStorage.setItem('scannerSettings', JSON.stringify(settings));
            dashboard.showNotification('Settings saved successfully', 'success');
            
            // Close modal
            bootstrap.Modal.getInstance(document.getElementById('settingsModal')).hide();
        }
        
        // Load saved settings on page load
        document.addEventListener('DOMContentLoaded', function() {
            const savedSettings = localStorage.getItem('scannerSettings');
            if (savedSettings) {
                const settings = JSON.parse(savedSettings);
                Object.keys(settings).forEach(key => {
                    const element = document.getElementById(key);
                    if (element) {
                        if (element.type === 'checkbox') {
                            element.checked = settings[key];
                        } else {
                            element.value = settings[key];
                        }
                    }
                });
            }
        });
    </script>
}